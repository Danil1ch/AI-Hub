{
  "name": "ai-hub",
  "version": "0.1.0",
  "productName": "AI Hub",
  "description": "Desktop workspace for AI chat services",
  "author": "Danil1ch",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "generate:icon": "node ./scripts/generate-app-icon.mjs",
    "dev": "npm run generate:icon && electron-vite dev",
    "build": "npm run generate:icon && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "dev.aihub.desktop",
    "productName": "AI Hub",
    "extraMetadata": {
      "productName": "AI Hub"
    },
    "directories": {
      "output": "release"
    },
    "files": ["out/**/*", "package.json"],
    "asar": true,
    "asarUnpack": ["out/preload/**"],
    "extraResources": [
      {
        "from": "resources/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "resources/app-icon.png",
      "executableName": "AIHub",
      "signAndEditExecutable": false,
      "legalTrademarks": "AI Hub"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
